# Copie para .env e ajuste. Não versione o .env.
# Senha do usuário "sa" do SQL Server no container (mín. 8 caracteres, com maiúsculas, minúsculas, números e símbolo).
MSSQL_SA_PASSWORD=TroqueEsta#Senha123

# Conexão usada pela API e pelo script de migrations.
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=TroqueEsta#Senha123
DB_NAME=CadastroCurriculos
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# API
PORT=3333
CORS_ORIGIN=http://localhost:5173

# Portas publicadas pelo docker compose (aplicação completa)
WEB_PORT=8080
API_PORT=3333
